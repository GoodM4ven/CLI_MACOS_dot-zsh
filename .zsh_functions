# system
own() { sudo chown -R "$USER":"$USER" "${1:-.}"; }
shutdown() {
  read -p "Are you sure you want to shutdown? [y/N]: " confirm
  [[ "$confirm" =~ ^[yY]$ ]] && sudo shutdown "$@" || echo "Cancelled."
}
wholecleanup() {
  echo "Disk usage before:"
  df -h / | tail -1

  echo "==> Emptying Trash..."
  find ~/.Trash -mindepth 1 -delete 2>/dev/null

  echo "==> Cleaning Homebrew cache..."
  brew cleanup -s 2>/dev/null

  echo "==> Clearing Helium browser cache..."
  rm -rf ~/Library/Caches/net.imput.helium/* 2>/dev/null

  echo "==> Deleting leftover .dmg/.pkg installers in Downloads..."
  find ~/Downloads -maxdepth 1 \( -iname "*.dmg" -o -iname "*.pkg" \) -delete 2>/dev/null

  echo "==> Cleaning npm cache..."
  npm cache clean --force 2>/dev/null

  echo "==> Pruning pnpm store..."
  pnpm store prune 2>/dev/null

  echo "Disk usage after:"
  df -h / | tail -1
}

# Laravel
dev() {
  php artisan optimize:clear
  composer dev
}
npb() {
  php artisan optimize:clear
  if [ -f pnpm-lock.yaml ]; then
    pnpm run build
  else
    npm run build
  fi
}
bench() { APP_ENV=local APP_DEBUG=true ./vendor/bin/testbench "$@"; }
pestbug() {
  clear
  local slowmo="${1:-400}"
  shift || true

  HEADLESS=false PWDEBUG=1 PW_SLOW_MO="$slowmo" ./vendor/bin/pest "$@"
}

