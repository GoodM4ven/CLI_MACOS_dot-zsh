# Git
alias girm='f() { git rm -r --cached "$1"; }; f'
oopsie() {
  local current_branch target_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)" || return 1
  target_branch="${1:-$current_branch}"
  git fetch origin || return 1
  git rebase "origin/$current_branch" || return 1
  if [ "$target_branch" != "$current_branch" ]; then
    git rebase "origin/$target_branch" || return 1
  fi
  git push --force-with-lease origin "$current_branch"
}

